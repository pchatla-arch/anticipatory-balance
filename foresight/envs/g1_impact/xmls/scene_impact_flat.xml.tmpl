<mujoco model="g1 impact scene">
  <!-- {G1_XML_DIR} and the robot file are substituted at load time by foresight.envs.g1_impact.scene,
       which also injects torso/pelvis collision capsules into the robot xml (the feet-only model has none). -->
  <include file="{ROBOT_XML}"/>

  <statistic center="0 0 0.7" extent="1.2" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <global azimuth="140" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
      markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"/>
    <!-- Approaching object: free body, parked far away until launch. Mass is set per episode. -->
    <body name="projectile" pos="{PARK_X} 0 {PARK_Z}">
      <freejoint name="projectile_free"/>
      <geom name="projectile_geom" type="sphere" size="{PROJ_RADIUS}" mass="{PROJ_MASS}"
            contype="0" conaffinity="0" rgba="0.9 0.3 0.1 1"
            solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>

  <contact>
    <pair name="proj_torso"  geom1="projectile_geom" geom2="torso_impact_geom"  condim="3" friction="0.6 0.6"/>
    <pair name="proj_pelvis" geom1="projectile_geom" geom2="pelvis_impact_geom" condim="3" friction="0.6 0.6"/>
    <pair name="proj_lthigh" geom1="projectile_geom" geom2="left_thigh"  condim="3" friction="0.6 0.6"/>
    <pair name="proj_rthigh" geom1="projectile_geom" geom2="right_thigh" condim="3" friction="0.6 0.6"/>
    <pair name="proj_floor"  geom1="projectile_geom" geom2="floor" condim="3" friction="0.6 0.6"/>
  </contact>

  <include file="{G1_XML_DIR}/sensor.xml"/>

  <keyframe>
    <!-- Playground's knees_bent pose, plus the projectile's 7 free-joint coordinates appended. -->
    <key name="knees_bent"
      qpos="
      0 0 0.755
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      {PARK_X} 0 {PARK_Z} 1 0 0 0
      "
      ctrl="
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "/>
  </keyframe>
</mujoco>
